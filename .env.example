# 세션 서명 키 (필수 권장: 긴 랜덤 문자열. 없으면 재시작할 때마다 로그아웃됨)
SECRET=change-me-to-a-long-random-string

# 데이터베이스 (Postgres). 비워두면 로컬 개발용 내장 DB(data/pgdata)를 사용합니다.
# 배포: Supabase "Transaction pooler" 연결 문자열 (포트 6543)
DATABASE_URL=

PORT=3000
# 배포 주소 (메일 속 링크와 OAuth 콜백의 기준). 운영 시 https 주소로
BASE_URL=http://localhost:3000

# 발송용 SMTP — 비워두면 outbox/ 폴더에 파일로 저장 (테스트 모드)
# Gmail: smtp.gmail.com / 587 / 앱 비밀번호 사용
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# Google 로그인 (선택) — Google Cloud Console에서 OAuth 클라이언트 생성,
# 승인된 리디렉션 URI: {BASE_URL}/auth/google/callback
# 이미지 업로드(Supabase Storage). 서버 전용 비밀 키 — 브라우저/채팅/저장소에 노출 금지. 비우면 로컬 uploads/ 폴더 사용(개발용)
SUPABASE_SERVICE_ROLE_KEY=

# 예약 발송/시리즈를 처리하는 /api/cron 호출 인증용 (긴 랜덤 문자열)
CRON_SECRET=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Pro/Business 요금제 (페이앱) — 네 값이 모두 있으면 페이앱으로 결제하고 플랜별 한도를 적용 (PG_PROVIDER 를 비워 두면 페이앱). 판매자 관리 사이트 "설정 > 연동 정보"에서 확인
# 결제 통보 주소는 {BASE_URL}/payapp/feedback 로 자동 전달되므로 BASE_URL 은 외부에서 접속 가능한 주소여야 함
PAYAPP_USERID=
PAYAPP_LINKKEY=
PAYAPP_LINKVAL=
PAYAPP_REQUESTKEY=

# 독자 유료 구독 결제와 수동 정산 신청을 연다 (1이면 켜짐). 대금이 Lett 판매자 계정으로 들어오는 구조이므로 정산 방식을 확정하고 법무 검토를 마친 뒤에만 켜세요
CREATOR_PAYMENTS_ENABLED=
# 외부 결제 수수료(%). 계약 요율을 넣으면 예상 정산금액에서 차감합니다. 비우면 "별도"로 표시 (페이앱 통보에는 수수료 금액이 오지 않음)
PG_FEE_PCT=

# 유료 구독 (Stripe) — 비워두면 결제 버튼이 비활성화됨
# 웹훅 주소: {BASE_URL}/stripe/webhook  (이벤트: checkout.session.completed, invoice.paid, customer.subscription.deleted)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=krw

# 인증·재설정 메일에 표시되는 서비스 이름
PLATFORM_NAME=lett.
# 뉴스레터당 24시간 발송 한도(통). SMTP 업체 한도보다 낮게 설정하세요
DAILY_SEND_LIMIT=1000

# 메일 사이 간격(ms) — SMTP 속도 제한 대응
SEND_DELAY_MS=150

# 푸터·정책 페이지에 표시되는 사업자 정보 (비우면 해당 항목은 표시하지 않음)
SUPPORT_EMAIL=
SUPPORT_PHONE=
# 통신판매업 신고 후 신고번호 입력
BIZ_MAIL_ORDER_NO=

# 가격·거래 수수료·한도는 src/plan-data.js 의 PLAN_CONFIG 에서 바꿉니다
# 플랫폼 요금제 결제 PG사 어댑터 이름 (src/plans.js 의 PROVIDERS 참고). 비우면 결제 버튼은 "준비 중"
# 개발 중에는 mock 으로 결제 흐름을 시험할 수 있음 (운영 환경에서는 동작하지 않음)
PG_PROVIDER=

# 플랜별 기능 제한 유예: CUTOFF 이전에 가입한 계정은 UNTIL 까지 Business 권한으로 쓴다 (UTC ISO 형식, 비우면 2026-11-05 / 2026-12-05 한국 시간 0시)
PLAN_GRACE_CUTOFF=
PLAN_GRACE_UNTIL=

# 정산: 신청 가능한 최소 금액(원), 운영자 화면(/admin, /admin/payouts)을 쓸 이메일(쉼표로 구분, 이메일 인증된 계정만)
MIN_PAYOUT=10000
ADMIN_EMAILS=
